# Copy to .env.local and fill in your keys. .env.local is gitignored.

# --- Required ---
# TMDB API key — powers the title/person catalogue and metadata.
# https://www.themoviedb.org/settings/api
TMDB_KEY=

# Recommendation agent (MiniMax M2, OpenAI-compatible API).
# https://www.minimax.io/
MINIMAX_API_KEY=

# --- Voice input (at least one required for speech-to-text) ---
# Groq Whisper — primary transcription provider.
GROQ_API_KEY=
# OpenAI — fallback transcription provider if GROQ_API_KEY is unset.
OPENAI_API_KEY=

# --- Accounts & watchlist (optional — features disable cleanly without it) ---
# Postgres connection string. Reachable from the app container, e.g.
# postgresql://natter:<password>@postgres:5432/natter
DATABASE_URL=
# Reserved for future signed payloads (sessions are DB-backed random tokens).
SESSION_SECRET=

# --- Feedback admin (optional, required for /admin/feedback) ---
# Keep real values in .env.local only. Do not commit credentials.
NATTER_ADMIN_USER=
NATTER_ADMIN_PASSWORD=
# Optional bearer token for periodic feedback-review agents.
NATTER_AGENT_TOKEN=

# --- Optional ---
# Override the agent model (default: MiniMax-M2).
MINIMAX_MODEL=
# Override the agent API base URL (default: https://api.minimax.io/v1).
MINIMAX_BASE_URL=
# Brave Search — supplementary web lookups. Omit to disable.
# Also the fallback game source when RAWG_API_KEY is unset.
BRAVE_SEARCH_API_KEY=

# --- Recommendation domains: books / games / recipes (all optional) ---
# Books — Google Books works keyless (lower quota); set a key for higher limits.
# https://developers.google.com/books/docs/v1/using#APIKey
GOOGLE_BOOKS_API_KEY=
# Games — RAWG free API key (https://rawg.io/apidocs). WITHOUT it, games fall
# back to a limited web-search result (no covers/metacritic). Recommended.
RAWG_API_KEY=
# Recipes — TheMealDB. '1' is the free public test key; a Patreon key overrides it.
THEMEALDB_KEY=1

# Redis L2 cache (optional). Speeds repeat searches + eases provider quotas.
# Everything degrades to a clean no-op when unset.
REDIS_URL=
