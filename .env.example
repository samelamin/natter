# Copy to .env.local and fill in your keys. .env.local is gitignored.

# --- Required ---
# TMDB API key — powers the title/person catalogue and metadata.
# https://www.themoviedb.org/settings/api
TMDB_KEY=

# Recommendation agent (MiniMax M2, OpenAI-compatible API).
# https://www.minimax.io/
MINIMAX_API_KEY=

# --- Voice input (at least one required for speech-to-text) ---
# Groq Whisper — primary transcription provider.
GROQ_API_KEY=
# OpenAI — fallback transcription provider if GROQ_API_KEY is unset.
OPENAI_API_KEY=

# --- Accounts & watchlist (optional — features disable cleanly without it) ---
# Postgres connection string. Reachable from the app container, e.g.
# postgresql://natter:<password>@postgres:5432/natter
DATABASE_URL=
# Reserved for future signed payloads (sessions are DB-backed random tokens).
SESSION_SECRET=

# --- Optional ---
# Override the agent model (default: MiniMax-M2).
MINIMAX_MODEL=
# Override the agent API base URL (default: https://api.minimax.io/v1).
MINIMAX_BASE_URL=
# Brave Search — supplementary web lookups. Omit to disable.
BRAVE_SEARCH_API_KEY=
